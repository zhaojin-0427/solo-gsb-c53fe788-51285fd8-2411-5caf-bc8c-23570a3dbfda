DATABASE_URL=postgresql+psycopg2://lab:lab@postgres:5432/lab_planning
SOLVER_TIME_LIMIT_SECONDS=5
# Seconds a concurrent request with the same Idempotency-Key waits for the
# first request to finish before receiving 409 idempotency_in_progress.
IDEMPOTENT_LOCK_TIMEOUT_SECONDS=30
# An unfinished in_progress marker older than this (seconds) is treated as a
# crashed predecessor and its key may be retaken.
IDEMPOTENT_STALE_TIMEOUT_SECONDS=120
